# Local development placeholders only. Compose binds data-service ports to loopback.
DATABASE_PASSWORD=pokerlab-local
# For IDE processes use the host port instead of the Compose service name:
DATABASE_URL=jdbc:postgresql://localhost:5432/pokerlab
DATABASE_USER=pokerlab
QUEUE_MODE=sqs
AWS_REGION=eu-west-2
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
SQS_ENDPOINT=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/pokerlab
SQS_DLQ_URL=http://localhost:4566/000000000000/pokerlab-dlq
REDIS_HOST=localhost
